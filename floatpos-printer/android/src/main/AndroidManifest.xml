<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The MobiIoT print service is a separate app on the device. Android 11+
         hides other packages unless they are declared here, and without this
         MobiiotAPI.init() binds to nothing and the printer silently does not
         exist. -->
    <queries>
        <package android:name="com.sagereal.printer" />
        <package android:name="com.mobiwire.printraw" />
        <intent>
            <action android:name="com.sagereal.printer.PrinterInterface" />
        </intent>
        <intent>
            <action android:name="com.mobiwire.printraw.PrintIOInterface" />
        </intent>
    </queries>
</manifest>
